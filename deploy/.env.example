# Production secrets belong at:
# /srv/voidsmith/shared/secrets/reviverelay/runtime.env
# Never commit real values. Production file mode must be 0600.
NODE_ENV=production
PORT=3100
REVIVERELAY_APP_DIR=/srv/voidsmith/torn-platform/reviverelay/app
REVIVERELAY_DATA_DIR=/srv/voidsmith/torn-platform/reviverelay/data/postgres
REVIVERELAY_BACKUP_DIR=/srv/voidsmith/torn-platform/reviverelay/backups/postgres
REVIVERELAY_ENV_FILE=/srv/voidsmith/shared/secrets/reviverelay/runtime.env
REVIVERELAY_COMPOSE_PROJECT=reviverelay
REVIVERELAY_DB_NAME=reviverelay
REVIVERELAY_DB_USER=reviverelay_app
REVIVERELAY_DB_PASSWORD=replace-with-strong-dedicated-password
DATABASE_URL=postgres://reviverelay_app:replace-with-strong-dedicated-password@reviverelay-db:5432/reviverelay
API_KEY_ENCRYPTION_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
SESSION_TOKEN_PEPPER=replace-with-random-session-pepper
TORN_API_BASE_URL=https://api.torn.com/v2
OPERATOR_TORN_ID=123456
ADMIN_API_TOKEN=replace-with-random-admin-token
SHEETS_MIRROR_URL=
SHEETS_MIRROR_TOKEN=
PAID_TIER_ENABLED=false
